# ============================================================
# .cn 国内站（阿里云 ECS 北京）环境变量模板
# ------------------------------------------------------------
# 用法：复制为本机 /opt/cn/.env.cn 后填入真实值。
# 本文件不含任何真实密钥，仅作模板。
# 仅用于 .cn 部署；.com 站请使用各自的 env。
#
# ⚠️ 红线提醒：
#   1) 数据不出境：DATABASE_URL_CN 必须指向境内（RDS PG 北京 / ECS 本地 PG），
#      绝不指向 *.neon.tech 等境外地址。
#   2) .cn 不碰资金：WECHAT_PAY_* 仅供「担保交易意图 + 回调验签」，不做分账/payout。
#   3) 备案前不对外：CN_ICP_NO 在备案号下发前保持占位，不得填真实业务数据，
#      且 usedfarmmach.cn 的 DNS 不得指向 ECS 公网 IP（101.200.125.199）。
#
# 命名隔离：WECHAT_PAY_*（收付通，src/lib/payments/wechat.ts）
#          与既有 WECHAT_*（普通 Native 商户，src/lib/wechat-pay.ts）严格区分，不可混用。
# ============================================================


# ---------- 站点标识（必填） ----------
# 激活 .cn 站，固定值 cn
SITE=cn

# 客户端站点标识（构建期注入，固定值 cn）
NEXT_PUBLIC_SITE=cn

# 站点公网地址（构建期注入）。注意：NEXT_PUBLIC_* 在构建时内联，
# 主机 env_file 中保留此行无害，但真正生效的是 CI 构建期传入的值。
NEXT_PUBLIC_APP_URL=https://usedfarmmach.cn


# ---------- 数据库（必填，境内） ----------
# .cn 境内数据库：本部署采用 ECS 本地 PG（docker postgres:16 + volume，零额外采购）。
# 不指向 *.neon.tech 等境外地址（数据不出境红线）。
# app 通过 docker 网络服务名 cn-postgres 连接；部署到 ECS 后由 docker-compose 自动带起。
# CN_DB_* 用于初始化 postgres 容器（见 docker-compose.yml postgres 服务）。
CN_DB_USER=cn_app
CN_DB_PASSWORD=set_a_strong_password_here
CN_DB_NAME=usedfarmmach_cn
# 应用连接串（host 用 docker 服务名 cn-postgres，5432 为容器内端口）
DATABASE_URL_CN=postgresql://cn_app:set_a_strong_password_here@cn-postgres:5432/usedfarmmach_cn?schema=public

# 可选：.com 的 Neon（cn 运行时不需要；主机可省略，留空即可）
DATABASE_URL=


# ---------- 鉴权（必填） ----------
# JWT 签名密钥，强随机串。生成示例：openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret
# 可选：JWT 有效期（默认 7d）
JWT_EXPIRES_IN=7d


# ---------- 阿里云 OSS（北京，必填） ----------
# 注意：上传代码（oss-upload.ts / ai-image-upload / miniapp/oss-token /
# field-videos / oss/sign / image-url.ts）实际写入的 bucket 为 usedfarmmach-oss，
# 与 .com 共用同一北京 bucket；数据始终在 oss-cn-beijing（红线：不出境）。
# 下方 OSS_BUCKET / OSS_BASE_URL 已与代码实际值对齐，避免误导。
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=your-aliyun-access-key-id
OSS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
OSS_BUCKET=usedfarmmach-oss
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# 图片基础 URL：image-url.ts 读取 OSS_BASE_URL（回退 usedfarmmach-oss.oss-cn-beijing）
OSS_BASE_URL=https://usedfarmmach-oss.oss-cn-beijing.aliyuncs.com


# ---------- 微信收付通（担保交易，必填） ----------
# 与既有 WECHAT_* 普通商户严格区分，以下均为 WECHAT_PAY_* 前缀。
WECHAT_PAY_APP_ID=wx-your-cn-miniapp-appid
WECHAT_PAY_MCH_ID=1900000000
# API V3 密钥，32 字节
WECHAT_PAY_API_V3_KEY=replace-with-32-byte-api-v3-key
WECHAT_PAY_SERIAL_NO=your-merchant-cert-serial-no
# 商户私钥 PEM；若含换行请用 \n 转义，或保持多行（双引号包裹）
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_BODY\n-----END PRIVATE KEY-----"
# 担保交易支付结果通知地址（需与代码中实际 notify 路由一致）
WECHAT_PAY_NOTIFY_URL=https://usedfarmmach.cn/api/trade/wechat/notify

# 电商收付通子商户号（担保交易下单的 sub_mchid，必填）；
# 与既有 WECHAT_SUB_MERCHANT_ID（普通 Native 商户）严格区分，不可混用。
# 担保交易意图 route 读取（回退 WECHAT_SUB_MERCHANT_ID）；未配置时 POST /api/trade/intent 返回 503。
WECHAT_PAY_SUB_MERCHANT_ID=your-sub-merchant-id

# 可选：微信平台证书公钥 PEM（严格验签）；缺省降级为仅解密
WECHAT_PAY_PLATFORM_CERT=


# ---------- 备案号（必填，备案前填占位，备案后填真实号） ----------
# 注意：备案号下发前不得对外、不得填真实业务数据；真实号格式以管局下发为准。
# 当前占位前缀「冀ICP备」（待确认省份，应与企业实名主体省份一致，
# 例如北京应为「京ICP备XXXXXX号」）。
CN_ICP_NO=冀ICP备XXXXXXXX号


# ---------- 已固化（Dockerfile.cn 已设置，主机通常无需设置） ----------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1


# ============================================================
# 以下为「按需可选」运行时变量：仅当启用对应 .cn 功能时才需要。
# 部署最小化启动可不填；启用相关功能（AI 估值 / 智能体 / 小程序 / 邮件）再补。
# 这些变量非 §2.1 强制清单，但 .cn 运行时若命中对应代码路径则会读取。
# ============================================================

# AI 估值 / 视觉识别（valuation / image-analyzer / video-analyzer）
# GOOGLE_API_KEY=xxx
# OPENROUTER_API_KEY=xxx

# 智能体（buyer-chat / seller-helper / deep-analysis 等，可选国内 Ark 模型）
# ARK_API_KEY=xxx
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL_ID=doubao-seed-evolving

# 小程序 / 内部接口鉴权
# MINIAPP_API_KEY=xxx
# INTERNAL_API_KEY=xxx
# WX_APP_ID=xxx
# WX_APP_SECRET=xxx

# .cn 邮件（国内）：阿里云 DirectMail（替代境外 resend）
# EMAIL_PROVIDER_DOMESTIC=aliyun_directmail
# ALIYUN_DM_ACCESS_KEY=xxx
# ALIYUN_DM_ACCESS_SECRET=xxx
# ALIYUN_DM_REGION=cn-hangzhou
# EMAIL_FROM=no-reply@usedfarmmach.cn

# 阿里云短信（展商入驻凭证通知，src/lib/sms.ts）
# 签名名称：必须与阿里云短信服务控制台「签名管理」中审核通过的签名【完全一致】（区分中英文/全半角）。
# 常见坑：多写"有限公司"或少写"科技"都会拒发。请从控制台「复制」粘贴最稳。
# 你账户下已审核通过的签名为「石家庄神雕农机科技」（注意：无"有限公司"后缀，
# 与控制台签名管理页逐字一致）。若与实际不符，改这里 + 下方 .env.local 同名变量即可。
ALIYUN_SMS_SIGN_NAME=石家庄神雕农机科技
# 模板 CODE：与控制台「模板管理」中审核通过的模板一致（如 SMS_510870105）
ALIYUN_SMS_TEMPLATE_CODE=SMS_510870105
# AccessKey：建议用 RAM 子用户专用 key（授权 AliyunDysmsFullAccess），不用主账号
ALIYUN_SMS_ACCESS_KEY_ID=your-aliyun-sms-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=your-aliyun-sms-access-key-secret

# 定时任务鉴权
# CRON_API_KEY=xxx
