# ============================================================
# Dockerfile.cn — .cn 国内站阿里云部署镜像
# 基于 Next.js standalone 输出模式
# ============================================================
FROM node:22-alpine AS base

# 设置时区
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# R4.1 修复：Prisma musl 引擎依赖 libssl。
# Alpine 3.19+ 已移除 openssl1.1-compat（提供 libssl.so.1.1 的包），
# 故安装 openssl3（提供 libssl.so.3），并配合 prisma/schema.prisma 的
# binaryTargets = linux-musl-openssl-3.0.x 使用 openssl3 引擎。
# 放 base 阶段：builder（构建期 prisma generate/next build）与
# runner（运行期 server.js 加载引擎）均继承，二者都需要。
RUN apk add --no-cache openssl

# ============================================================
# 依赖安装阶段
# ============================================================
FROM base AS deps
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --only=production && \
    npm cache clean --force

# ============================================================
# 构建阶段
# ============================================================
FROM base AS builder
WORKDIR /app

# 构建期数据库连接串，通过 --build-arg 从 CI 注入（GitHub Actions 内置临时 postgres service）：
# - DATABASE_URL：schema.prisma 的 datasource env("DATABASE_URL")，prisma generate 需变量存在
# - DATABASE_URL_CN：db.ts 在 SITE=cn 时读取，next build（ISR 预渲染）会真实连接
# 运行时容器仍使用 ECS 主机 /opt/cn/.env.cn 的 DATABASE_URL_CN（host=cn-postgres），
# 二者作用域不同、互不冲突。
ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL
ARG DATABASE_URL_CN
ENV DATABASE_URL_CN=$DATABASE_URL_CN

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# 设置 .cn 站点标识
ENV SITE=cn
ENV NEXT_PUBLIC_SITE=cn
ENV NODE_ENV=production

# Prisma 生成 + Next.js 构建（standalone 输出）
RUN npx prisma generate
RUN npm run build

# ============================================================
# 运行阶段
# ============================================================
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV SITE=cn
ENV NEXT_PUBLIC_SITE=cn
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# db push 复用 app 镜像离线执行，需 prisma CLI（全局安装，构建期有网；
# 版本与 client 对齐为 5.14.0）。runner 阶段 base 已装 openssl，且 schema 的
# binaryTargets = linux-musl-openssl-3.0.x，故镜像内 prisma 引擎可直接工作。
RUN npm install -g prisma@5.14.0

# 非 root 用户运行（安全最佳实践）
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs && \
    mkdir -p /app/.next/cache/images && \
    chown -R nextjs:nodejs /app

# 从 builder 复制 standalone 构建产物
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

# .cn 内容同步：部署后由 deploy-cn.sh 在容器内执行，把镜像内 daily-reports JSON 导入 cn-postgres
COPY --from=builder --chown=nextjs:nodejs /app/scripts/import-articles-to-cn.js ./scripts/import-articles-to-cn.js
COPY --from=builder --chown=nextjs:nodejs /app/scripts/import-intelligence-to-cn.js ./scripts/import-intelligence-to-cn.js

# #1 卖方采集（境内 ECS 运行）：种子台账 + 入库 + 运行器随镜像打包（cn-scout sidecar 调用）。
# 已移除 Python 爬虫（被国内平台 WAF 拦截且会挂死），改为纯种子台账入库。
COPY --from=builder --chown=nextjs:nodejs /app/scripts/import-seller-scout-domestic.js ./scripts/import-seller-scout-domestic.js
COPY --from=builder --chown=nextjs:nodejs /app/scripts/run-domestic-scout.sh ./scripts/run-domestic-scout.sh
RUN chmod +x ./scripts/run-domestic-scout.sh
# 国内 WebSearch 台账种子（唯一数据源，随镜像部署，cron 每日自动入库）
COPY --from=builder --chown=nextjs:nodejs /app/scripts/domestic_sellers_seed.json ./scripts/domestic_sellers_seed.json
# busybox crond 每日定时任务（cn-scout 容器读取 /var/spool/cron/crontabs/root）
COPY --from=builder --chown=root:root /app/scripts/scout-crontab /var/spool/cron/crontabs/root

USER nextjs

EXPOSE 3000

# 健康检查固定使用 127.0.0.1（IPv4）。Alpine 的 busybox wget 解析 localhost 时
# 优先返回 IPv6 地址 [::1]:3000，而 Next.js standalone 仅绑定 IPv4（0.0.0.0:3000），
# 会导致 healthcheck 始终 Connection refused、容器被标记为 unhealthy、ECS 部署失败。
# 改用 127.0.0.1 强制走 IPv4，确保健康检查正常通过。
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/zh || exit 1

CMD ["node", "server.js"]
