{
  "crons": [
    {
      "path": "/api/cron/update-prices?token=${INTERNAL_API_KEY}",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/cron/benchmark?token=${INTERNAL_API_KEY}",
      "schedule": "30 23 * * 0"
    },
    {
      "path": "/api/cron/daily-report?token=${INTERNAL_API_KEY}",
      "schedule": "45 23 * * *"
    },
    {
      "path": "/api/cron/keep-alive?token=${INTERNAL_API_KEY}",
      "schedule": "50 0,5 * * *"
    },
    {
      "path": "/api/cron/cn-product-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cn-product-sync-reconcile",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/update-exchange-rates?token=${INTERNAL_API_KEY}",
      "schedule": "0 2 * * *"
    }
  ]
}
