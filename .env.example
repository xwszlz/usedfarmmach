# ============================================================
# 站点标识
# ============================================================
# 当前站点：com（国际化）| cn（国内）
SITE="com"
NEXT_PUBLIC_SITE="com"
# .cn 站域名（SITE=cn 时使用）
SITE_DOMAIN="usedfarmmach.cn"

# ============================================================
# Database
# ============================================================
# .com 站数据库（Neon 境外）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/usedfarmmach?schema=public"
# .cn 站数据库（阿里云 RDS 北京，数据不出境）
DATABASE_URL_CN="postgresql://postgres:postgres@localhost:5432/usedfarmmach_cn?schema=public"

# ============================================================
# JWT
# ============================================================
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ============================================================
# Aliyun OSS（两站共用，纯静态资产不涉 PII）
# ============================================================
OSS_REGION="oss-cn-beijing"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET="usedfarmmach-oss"
OSS_ENDPOINT="https://oss-cn-beijing.aliyuncs.com"

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_OSS_CDN=""

# ============================================================
# 邮件服务
# ============================================================
# Resend（美国，境外处理方；.com 站使用）
RESEND_API_KEY=""
# ---- Resend 收信 → 腾讯企业邮邮件群组 转发（2026-11-20 新增）----
# webhook 验签密钥：Resend Dashboard → Webhooks → 该 endpoint 详情页的 Signing Secret（whsec_ 开头）。
# 未配置时 /api/resend/inbound 直接 200 跳过（本地、.cn 构建都安全）。
RESEND_WEBHOOK_SECRET=""
# 收件地址 → 群组地址映射，留空即用内置默认（同名地址换域名）：
#   support@usedfarmmach.com   → support@shendiaotech.cn
#   sales@usedfarmmach.com     → sales@shendiaotech.cn
#   marketing@usedfarmmach.com → marketing@shendiaotech.cn
# 群组账号在腾讯企业邮设定后不可修改，改名只改这里，不用动代码。
INBOUND_GROUP_SUPPORT=""
INBOUND_GROUP_SALES=""
INBOUND_GROUP_MARKETING=""
# ⚠️ 已废弃（2026-11-20）：发件人地址由代码内置 = support@{当前站域名}
# （见 src/config/site.ts 的 systemFromEmail），不再读 EMAIL_FROM。
# Vercel / ECS 上若仍残留此变量，可安全删除。
# 历史坑：曾把它填成 "EMAIL_FROM=xxx@yyy.com"（把键名一起写进 Value），
# 于是发件人变成非法字符串、全部发信失败，且业务接口仍返回 success（静默）。
# EMAIL_FROM="support@usedfarmmach.com"
# 邮件服务商切换：resend（默认）| aliyun_directmail | tencent_ses
EMAIL_PROVIDER="resend"
# .cn 站国内邮件服务商（备案后生效）
EMAIL_PROVIDER_DOMESTIC="aliyun_directmail"

# ---- P1 分站发信通道（additive，旧变量保留兼容但不再是路由主依据）----
# 路由真相源 = SITE：.com → Resend；.cn → 腾讯云 SES。
# 系统发信 from = 客服地址 = support@usedfarmmach.{com|cn}（收发同一地址，客户可回复）。
SEND_FROM_NAME=""
# 显示名缺省按站分流：.cn=神雕农机 / .com=UsedFarmMach；此处留空即用默认。
# 可选：Reply-To 缺省自动回落 supportEmail（客户点「回复」直达 Inbox），无需配置。
EMAIL_REPLY_TO=""
# .cn 腾讯云 SES SMTP（授权码，不是 SecretKey；缺任一项则 console 降级，绝不回退 Resend）
TENCENT_SES_SMTP_USER=""
TENCENT_SES_SMTP_PASS=""
TENCENT_SES_SMTP_HOST="smtp.qcloudmail.com"
TENCENT_SES_SMTP_PORT="465"

# ============================================================
# AI Valuation API Keys
# ============================================================
GOOGLE_API_KEY=""
OPENROUTER_API_KEY=""

# ============================================================
# .cn 站专属配置
# ============================================================
# ICP 备案号（.cn 站页面底部展示）
CN_ICP_NO="冀ICP备XXXXXXXX号"
# .cn 站增值服务费合规命名（非"交易费/佣金"）
CN_SERVICE_FEE_LABEL="增值信息服务费"

# ============================================================
# Paddle（.com 国际站积分充值，Merchant of Record，自动算税代缴 VAT/GST）
# ============================================================
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# sandbox | production；联调时用 sandbox
PADDLE_ENV=sandbox
# 可选：在 Paddle 后台建好 Product/Price 后填入；留空则走内联价格
PADDLE_PRICE_ID_CREDITS_USD=
# 前端（Paddle.js 结账浮层）需要；NEXT_PUBLIC_ 前缀才会注入客户端
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# 必须与后端 PADDLE_ENV 一致（sandbox / production），
# 否则前端打不开后端创建的交易，结账浮层弹不出来
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ============================================================
# 微信支付 Native（仅 .cn 站积分充值，普通商户直收）
# ============================================================
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_V3_KEY=""
WECHAT_SERIAL_NO=""
WECHAT_PRIVATE_KEY=""  # 商户私钥 PEM（内联字符串，非文件路径；代码读此名）

# ============================================================
# 支付宝当面付/电脑网站支付（仅 .cn 站使用）
# ============================================================
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
ALIPAY_NOTIFY_URL=""

# ============================================================
# 企业微信客服
# ============================================================
WECOM_CORP_ID=""
WECOM_KF_TOKEN=""
WECOM_KF_AES_KEY=""
WECOM_KF_SECRET=""
WECOM_GROUP_WEBHOOK_URL=""

# ============================================================
# .cn → .com 产品同步（Stage 0/1）
# ============================================================
# 导出接口鉴权密钥（server-to-server）。生成：openssl rand -hex 32
# .com 写 Vercel env（同步任务携带 x-sync-key），.cn 写 /opt/cn/.env.cn（导出接口校验）
CN_SYNC_API_KEY=""

# 导出接口基址（可选；缺省 / 留空即用 https://usedfarmmach.cn）
CN_SYNC_BASE_URL=""

# 对账护栏：最近 N 轮存在 error 则跳过删除（可选；缺省 3）
CN_SYNC_RECONCILE_GUARD_N="3"

# Vercel Cron 鉴权（Vercel 自动以 Authorization: Bearer <CRON_SECRET> 发送）
# ⚠️ 必须配置，否则两条新 cron（cn-product-sync / cn-product-sync-reconcile）永久 503
CRON_SECRET=""
