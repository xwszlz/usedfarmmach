# ============================================================
# 站点标识
# ============================================================
# 当前站点：com（国际化）| cn（国内）
SITE="com"
NEXT_PUBLIC_SITE="com"
# .cn 站域名（SITE=cn 时使用）
SITE_DOMAIN="usedfarmmach.cn"

# ============================================================
# Database
# ============================================================
# .com 站数据库（Neon 境外）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/usedfarmmach?schema=public"
# .cn 站数据库（阿里云 RDS 北京，数据不出境）
DATABASE_URL_CN="postgresql://postgres:postgres@localhost:5432/usedfarmmach_cn?schema=public"

# ============================================================
# JWT
# ============================================================
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ============================================================
# Aliyun OSS（两站共用，纯静态资产不涉 PII）
# ============================================================
OSS_REGION="oss-cn-beijing"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET="usedfarmmach-oss"
OSS_ENDPOINT="https://oss-cn-beijing.aliyuncs.com"

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_OSS_CDN=""

# ============================================================
# 邮件服务
# ============================================================
# Resend（美国，境外处理方；.com 站使用）
RESEND_API_KEY=""
EMAIL_FROM="no-reply@usedfarmmach.com"
# 邮件服务商切换：resend（默认）| aliyun_directmail | tencent_ses
EMAIL_PROVIDER="resend"
# .cn 站国内邮件服务商（备案后生效）
EMAIL_PROVIDER_DOMESTIC="aliyun_directmail"

# ============================================================
# AI Valuation API Keys
# ============================================================
GOOGLE_API_KEY=""
OPENROUTER_API_KEY=""

# ============================================================
# .cn 站专属配置
# ============================================================
# ICP 备案号（.cn 站页面底部展示）
CN_ICP_NO="冀ICP备XXXXXXXX号"
# .cn 站增值服务费合规命名（非"交易费/佣金"）
CN_SERVICE_FEE_LABEL="增值信息服务费"

# ============================================================
# Stripe（仅 .com 站使用）
# ============================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ============================================================
# 微信收付通（仅 .cn 站使用，资金在微信小程序闭环）
# ============================================================
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_V3_KEY=""
WECHAT_SERIAL_NO=""
WECHAT_PRIVATE_KEY_PATH=""

# ============================================================
# 企业微信客服
# ============================================================
WECOM_CORP_ID=""
WECOM_KF_TOKEN=""
WECOM_KF_AES_KEY=""
WECOM_KF_SECRET=""
WECOM_GROUP_WEBHOOK_URL=""

# ============================================================
# .cn → .com 产品同步（Stage 0/1）
# ============================================================
# 导出接口鉴权密钥（server-to-server）。生成：openssl rand -hex 32
# .com 写 Vercel env（同步任务携带 x-sync-key），.cn 写 /opt/cn/.env.cn（导出接口校验）
CN_SYNC_API_KEY=""

# 导出接口基址（可选；缺省 / 留空即用 https://usedfarmmach.cn）
CN_SYNC_BASE_URL=""

# 对账护栏：最近 N 轮存在 error 则跳过删除（可选；缺省 3）
CN_SYNC_RECONCILE_GUARD_N="3"

# Vercel Cron 鉴权（Vercel 自动以 Authorization: Bearer <CRON_SECRET> 发送）
# ⚠️ 必须配置，否则两条新 cron（cn-product-sync / cn-product-sync-reconcile）永久 503
CRON_SECRET=""
